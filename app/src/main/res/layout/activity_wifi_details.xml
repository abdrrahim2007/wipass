<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000000"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:elevation="0dp"/>
    <androidx.core.widget.NestedScrollView
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="4dp"
            android:paddingRight="16dp"
            android:paddingBottom="80dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#1e293b"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeColor="#334155"
                app:strokeWidth="2dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="rtl">
                    <ImageView
                        android:id="@+id/iconWifi"
                        android:layout_width="40dp"
                        android:layout_height="35dp"
                        android:src="@drawable/wifi"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#94a3b8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="إسم الشبكة"
                            android:fontFamily="@font/tajwal"/>
                        <TextView
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:ellipsize="end"
                            android:id="@+id/ssidValueHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="ADSL_inwi_2.4G"
                            android:maxLines="1"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="#1e293b"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layoutDirection="rtl">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/iconFrequency"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:src="@drawable/frequency"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#94a3b8"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="التردد"
                                android:fontFamily="@font/tajwal"/>
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#ffffff"
                                android:id="@+id/frequencyValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="2.4 GHz"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="#1e293b"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="2dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layoutDirection="rtl">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/iconSecurity"
                            android:layout_width="38dp"
                            android:layout_height="42dp"
                            android:src="@drawable/guaranteed"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#94a3b8"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="نوع الحماية"
                                android:fontFamily="@font/tajwal"/>
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#ffffff"
                                android:id="@+id/securityValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="WPA2"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#1e293b"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeColor="#334155"
                app:strokeWidth="2dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/bssidContainer"
                    android:background="@drawable/card_ripple"
                    android:padding="14dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="rtl">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/iconMac"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/copy"/>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#94a3b8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="عنوان MAC"
                            android:fontFamily="@font/tajwal"/>
                        <TextView
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:id="@+id/bssidValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="1A:2B:3C:4D:5E:6F"
                            android:fontFamily="monospace"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/deviceIpCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#1e293b"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeColor="#334155"
                app:strokeWidth="2dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/deviceIpContainer"
                    android:background="@drawable/card_ripple"
                    android:padding="14dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="rtl">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/device"/>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#94a3b8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="عنوان IP لجهاز"
                            android:fontFamily="@font/tajwal"/>
                        <TextView
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:id="@+id/deviceIpValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="192.168.1.100"
                            android:fontFamily="monospace"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/routerIpCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#1e293b"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeColor="#334155"
                app:strokeWidth="2dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/routerIpContainer"
                    android:background="@drawable/card_ripple"
                    android:paddingLeft="16dp"
                    android:paddingTop="12dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="12dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="rtl"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/router"/>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#94a3b8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="دخول على صفحة Router Web Interface"
                            android:lineSpacingExtra="2dp"
                            android:fontFamily="@font/tajwal"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:id="@+id/routerIpValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="192.168.1.1"
                            android:fontFamily="monospace"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/importPasswordsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#1e293b"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeColor="#334155"
                app:strokeWidth="2dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImportPasswords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="استيراد قائمة كلمات المرور (.txt)"
                        android:textSize="14sp"
                        android:textColor="#ffffff"
                        android:fontFamily="@font/tajwal"
                        app:backgroundTint="#2563eb"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/copy"
                        app:iconSize="20dp"
                        app:iconGravity="textStart"
                        style="@style/Widget.Material3.Button"/>
                    <TextView
                        android:id="@+id/txtImportStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:text="لم يتم تحميل أي كلمات مرور مخصصة"
                        android:textColor="#94a3b8"
                        android:textSize="13sp"
                        android:fontFamily="@font/tajwal"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:layout_gravity="bottom"
        android:id="@+id/btnSpeedTest"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_margin="16dp"
        android:text="تجربة إتصال بهذه الشبكة"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:fontFamily="@font/tajwal"
        app:backgroundTint="#1e293b"
        app:cornerRadius="16dp"
        app:elevation="8dp"
        app:icon="@drawable/ic_wifi_connect"
        app:iconGravity="end"
        app:iconPadding="8dp"
        app:iconSize="22dp"
        style="@style/Widget.Material3.Button"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
