<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#1e293b"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="true"
    app:strokeColor="#334155"
    app:strokeWidth="1dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="#1e293b"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:background="#1e293b"
            android:paddingLeft="24dp"
            android:paddingTop="20dp"
            android:paddingRight="24dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp">
            <View
                android:background="@drawable/success_circle_bg"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_centerHorizontal="true"
                android:alpha="0.12"/>
            <androidx.cardview.widget.CardView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_centerHorizontal="true"
                app:cardBackgroundColor="#334155"
                app:cardCornerRadius="34dp"
                app:cardElevation="4dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/successIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/success"
                    android:scaleType="fitCenter"/>
            </androidx.cardview.widget.CardView>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <View
                    android:background="@drawable/dot_indicator"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تم الحصول على كلمة المرور"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajwal"
                    android:letterSpacing="-0.01"/>
                <View
                    android:background="@drawable/dot_indicator"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
            <TextView
                android:textSize="13sp"
                android:textColor="#94a3b8"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="يمكنك الآن نسخها واستخدامها للاتصال"
                android:includeFontPadding="false"
                android:fontFamily="@font/tajwal"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#0f172a"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#10b981"
                app:strokeWidth="1.5dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.cardview.widget.CardView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:cardBackgroundColor="#10b981"
                        app:cardCornerRadius="19dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lock"
                            app:tint="#ffffff"/>
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/passwordText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="30dp"
                        android:letterSpacing="0.08"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton
                android:textSize="15sp"
                android:textStyle="bold"
                android:id="@+id/btnCopyPassword"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="نسخ كلمة المرور"
                android:fontFamily="@font/tajwal"
                android:letterSpacing="0.01"
                android:paddingVertical="12dp"
                app:backgroundTint="#10b981"
                app:cornerRadius="12dp"
                app:elevation="3dp"
                app:icon="@drawable/ic_copy"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="#ffffff"
                app:rippleColor="#ffffff"
                style="@style/Widget.MaterialComponents.Button"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/copySuccessIndicator"
                android:padding="6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_check"
                    app:tint="#10b981"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#10b981"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تم النسخ بنجاح"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajwal"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
