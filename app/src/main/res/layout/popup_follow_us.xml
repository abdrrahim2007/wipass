<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="#1a1a1a"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeColor="#10b981"
    app:strokeWidth="2dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="#1a1a1a"
        android:padding="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/starIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/about"
            android:scaleType="fitCenter"/>
        <View
            android:background="#10b981"
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/messageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="يمكنك الحصول على تفاصيل حول تطبيق من خلال أيقونة إعدادات في الأعلى"
            android:lineSpacingExtra="6dp"
            android:fontFamily="@font/tajwal"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/btnGotIt"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:minHeight="50dp"
            android:text="فهمتك"
            android:fontFamily="@font/tajwal"
            android:paddingVertical="13dp"
            app:backgroundTint="#10b981"
            app:cornerRadius="12dp"
            app:strokeWidth="0dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
