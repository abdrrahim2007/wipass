<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="#1e293b"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:strokeColor="#334155"
    app:strokeWidth="1dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="40dp"
        android:paddingBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">
        <View
            android:id="@+id/icon_background"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/icon_warning"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/alert"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="@+id/icon_background"
            app:layout_constraintEnd_toEndOf="@+id/icon_background"
            app:layout_constraintStart_toStartOf="@+id/icon_background"
            app:layout_constraintTop_toTopOf="@+id/icon_background"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/title_warning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="شبكة غير مدعومة"
            android:fontFamily="@font/tajwal"
            android:letterSpacing="-0.02"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon_background"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#94a3b8"
            android:gravity="center"
            android:id="@+id/popup_warning_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="عذرا ونتأسف لسماعك هذا لكن هذه الشبكة غير مدعومة حاليا في التطبيق و لذلك لن تنجح عملية الاتصال "
            android:lineSpacingExtra="4dp"
            android:alpha="0.9"
            android:fontFamily="@font/tajwal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_warning"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/buttons_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/popup_warning_message">
            <com.google.android.material.button.MaterialButton
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/btn_warning_try"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:text="حسنا فهمتك"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:fontFamily="@font/tajwal"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.01"
                app:backgroundTint="#f59e0b"
                app:cornerRadius="14dp"
                app:elevation="4dp"
                app:iconGravity="end"
                app:iconSize="18dp"
                app:iconTint="#ffffff"
                app:rippleColor="#ffffff"
                style="@style/Widget.Material3.Button.ElevatedButton"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
