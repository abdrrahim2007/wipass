<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="#1e293b"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeColor="#334155"
    app:strokeWidth="1dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingLeft="28dp"
        android:paddingTop="24dp"
        android:paddingRight="28dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="28dp">
        <ImageView
            android:id="@+id/icon_success"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/success"
            android:scaleType="fitCenter"
            android:alpha="0.9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/title_success"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="أنت تستعمل أحدث إصدار"
            android:fontFamily="@font/tajwal"
            android:letterSpacing="-0.01"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon_success"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#94a3b8"
            android:gravity="center"
            android:id="@+id/message_success"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="التطبيق محدث إلى آخر إصدار متاح."
            android:lineSpacingExtra="3dp"
            android:fontFamily="@font/tajwal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_success"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/btn_close"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="إغلاق"
            android:textAllCaps="false"
            android:fontFamily="@font/tajwal"
            android:letterSpacing="0"
            app:backgroundTint="#10b981"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/message_success"
            app:rippleColor="#ffffff"
            style="@style/Widget.Material3.Button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
