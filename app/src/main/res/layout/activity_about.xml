<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <com.google.android.material.appbar.AppBarLayout
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="32dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/about_logo"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="App Logo"/>
                <TextView
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="#1976d2"
                    android:id="@+id/tv_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="28dp"
                    android:text="WIPass"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.05"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#cbd5e1"
                    android:ellipsize="none"
                    android:gravity="center"
                    android:id="@+id/tv_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="تم تطويره من طرف Root4arab ولقد صمم خصيصاً لكشف نقاط ضعف في بعض شبكات الواي فاي في المغرب"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajwal"
                    android:textAlignment="center"
                    android:letterSpacing="0"
                    android:breakStrategy="high_quality"
                    android:hyphenationFrequency="full"
                    android:layout_marginHorizontal="20dp"
                    android:lineHeight="26sp"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="20dp">
                <View
                    android:id="@+id/header_line_social"
                    android:background="@drawable/gradient_line"
                    android:layout_width="60dp"
                    android:layout_height="4dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="روابط تـواصل و الدعم"
                    android:includeFontPadding="false"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/tajwal"
                    android:layout_marginStart="16dp"
                    android:layout_toEndOf="@+id/header_line_social"
                    android:letterSpacing="-0.01"/>
            </RelativeLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_youtube"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#1e293b"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/card_ripple"
                    android:paddingLeft="18dp"
                    android:paddingTop="14dp"
                    android:paddingRight="18dp"
                    android:paddingBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_youtube"
                        android:scaleType="fitCenter"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="18dp">
                        <TextView
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YouTube"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#94a3b8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@root4arab"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_arrow_right"
                        android:scaleType="fitCenter"
                        app:tint="#94a3b8"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_facebook"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#1e293b"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/card_ripple"
                    android:paddingLeft="18dp"
                    android:paddingTop="14dp"
                    android:paddingRight="18dp"
                    android:paddingBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/telegram"
                        android:scaleType="fitCenter"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="18dp">
                        <TextView
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Telegram"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#94a3b8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="root4arab"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_arrow_right"
                        android:scaleType="fitCenter"
                        app:tint="#94a3b8"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_email"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#1e293b"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/card_ripple"
                    android:paddingLeft="18dp"
                    android:paddingTop="14dp"
                    android:paddingRight="18dp"
                    android:paddingBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/email"
                        android:scaleType="fitCenter"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="18dp">
                        <TextView
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="البريد الإلكتروني"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/tajwal"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#94a3b8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="root4arab@proton.me"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_arrow_right"
                        android:scaleType="fitCenter"
                        app:tint="#94a3b8"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_privacy"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#1e293b"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/card_ripple"
                    android:paddingLeft="18dp"
                    android:paddingTop="14dp"
                    android:paddingRight="18dp"
                    android:paddingBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/info"
                        android:scaleType="fitCenter"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="18dp">
                        <TextView
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="رابط تطبيق عبر Gitlab"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/tajwal"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#94a3b8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="الإطلاع على باقي التفاصيل من هنا"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/tajwal"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_arrow_right"
                        android:scaleType="fitCenter"
                        app:tint="#94a3b8"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_check_update"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#1e293b"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/card_ripple"
                    android:paddingLeft="18dp"
                    android:paddingTop="14dp"
                    android:paddingRight="18dp"
                    android:paddingBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/update"
                        android:scaleType="fitCenter"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="18dp">
                        <TextView
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="تحقق من تحديث"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/tajwal"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#94a3b8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="التحقق من وجود تحديثات"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/tajwal"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_arrow_right"
                        android:scaleType="fitCenter"
                        app:tint="#94a3b8"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_share"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#1e293b"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/card_ripple"
                    android:paddingLeft="18dp"
                    android:paddingTop="14dp"
                    android:paddingRight="18dp"
                    android:paddingBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/share"
                        android:scaleType="fitCenter"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="18dp">
                        <TextView
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="مشاركة تطبيق"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/tajwal"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#94a3b8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="شارك التطبيق مع الأصدقاء"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/tajwal"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_arrow_right"
                        android:scaleType="fitCenter"
                        app:tint="#94a3b8"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
